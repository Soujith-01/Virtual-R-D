# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you need. NEVER commit the real `.env`.
# Every value has a safe default, so an empty config still runs the demo.
# ---------------------------------------------------------------------------

# --- app ---
DEBUG=true
# Explicit allow-list (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex of additionally allowed origins. Defaults to any localhost port so that a
# Vite port bump (5173 -> 5174) does not break the dashboard. Set empty to disable.
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# --- external LLM (optional) -----------------------------------------------
# Leave LLM_PROVIDER=none to run the demo with deterministic template
# explanations and no API key at all.
#
# LLM_PROVIDER : none | openai | groq | ollama | custom
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Example: OpenAI
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
# Example: Groq (OpenAI-compatible)
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.1-8b-instant
#   LLM_API_KEY=gsk_...
#
# Example: local Ollama
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1
#   LLM_BASE_URL=http://localhost:11434

# --- retrieval -------------------------------------------------------------
# auto | sentence-transformers | tfidf
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# --- experiment generation -------------------------------------------------
SEARCH_GRID_SIZE=900
DEFAULT_NUM_EXPERIMENTS=5
